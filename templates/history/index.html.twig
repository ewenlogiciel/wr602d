{% extends 'base.html.twig' %}

{% block title %}Historique — polypdf{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl px-6 py-12 lg:py-16">

    {# ── En-tête ── #}
    <div class="mb-10 animate-fade-up">
        <div class="flex items-center gap-3 mb-2">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#ff3b30]/10 border border-[#ff3b30]/20">
                <i class="fa-solid fa-clock-rotate-left text-[#ff3b30] text-sm"></i>
            </div>
            <h1 class="font-heading text-3xl font-extrabold tracking-[-0.03em] text-white">
                Historique
            </h1>
        </div>
        <p class="mt-1 text-[0.875rem] text-white/40">
            {% if generations|length > 0 %}
                {{ generations|length }} génération{{ generations|length > 1 ? 's' : '' }} au total
            {% else %}
                Aucune génération pour le moment
            {% endif %}
        </p>
    </div>

    {% if generations|length == 0 %}

        {# ── État vide ── #}
        <div class="animate-fade-up delay-100 flex flex-col items-center justify-center rounded-2xl border border-white/[0.06] bg-[#111118] py-24 text-center">
            <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/[0.08] bg-white/[0.03]">
                <i class="fa-regular fa-file-pdf text-3xl text-white/20"></i>
            </div>
            <p class="font-heading text-lg font-bold text-white/30">Aucune génération</p>
            <p class="mt-2 text-[0.82rem] text-white/20">
                Vos PDF générés apparaîtront ici.
            </p>
            <a href="{{ path('app_tools') }}"
               class="mt-8 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-[#ff3b30] to-[#ff6b35] px-6 py-2.5 text-[0.85rem] font-semibold text-white shadow-lg shadow-[#ff3b30]/20 transition-all hover:shadow-xl hover:shadow-[#ff3b30]/30 hover:scale-[1.02]">
                <i class="fa-solid fa-wand-magic-sparkles text-sm"></i>
                Générer un PDF
            </a>
        </div>

    {% else %}

        {# ── Liste des générations ── #}
        <div class="flex flex-col gap-3">
            {% for generation in generations %}
                <div class="animate-fade-up delay-{{ loop.index <= 5 ? loop.index * 100 : 500 }} group flex items-center gap-5 rounded-2xl border border-white/[0.07] bg-[#111118] px-5 py-4 transition-all duration-200 hover:border-white/[0.12] hover:bg-[#16161f]">

                    {# Icône de l'outil #}
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl"
                         {% if generation.tool %}
                             style="background: {{ generation.tool.color }}18; border: 1px solid {{ generation.tool.color }}30;"
                         {% else %}
                             style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);"
                         {% endif %}>
                        <i class="{{ generation.tool ? generation.tool.icon : 'fa-solid fa-file-pdf' }} text-base"
                           {% if generation.tool %}style="color: {{ generation.tool.color }};"{% else %}style="color: rgba(255,255,255,0.3);"{% endif %}></i>
                    </div>

                    {# Infos principales #}
                    <div class="min-w-0 flex-1">
                        <p class="font-heading text-[0.9rem] font-bold text-white truncate">
                            {{ generation.tool ? generation.tool.name : 'Outil supprimé' }}
                        </p>
                        {% if generation.source %}
                            <p class="mt-0.5 truncate text-[0.75rem] text-white/35" title="{{ generation.source }}">
                                <i class="fa-solid fa-{{ generation.source starts with 'http' ? 'link' : 'file' }} mr-1 opacity-60"></i>
                                {{ generation.source|length > 60 ? generation.source|slice(0, 60) ~ '…' : generation.source }}
                            </p>
                        {% endif %}
                    </div>

                    {# Date #}
                    <div class="hidden shrink-0 text-right sm:block">
                        <p class="text-[0.78rem] font-medium text-white/50">
                            {{ generation.createdAt|date('d/m/Y') }}
                        </p>
                        <p class="text-[0.7rem] text-white/25">
                            {{ generation.createdAt|date('H:i') }}
                        </p>
                    </div>

                    {# Bouton téléchargement #}
                    <a href="{{ path('app_history_download', {id: generation.id}) }}"
                       class="shrink-0 flex h-9 w-9 items-center justify-center rounded-xl border border-white/[0.08] bg-white/[0.04] text-white/40 transition-all hover:border-[#ff3b30]/40 hover:bg-[#ff3b30]/10 hover:text-[#ff3b30]"
                       title="Télécharger le PDF">
                        <i class="fa-solid fa-download text-sm"></i>
                    </a>

                </div>
            {% endfor %}
        </div>

    {% endif %}

</div>
{% endblock %}
