{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — PDFactory{% endblock %}

{% block body %}
<div class="flex min-h-[calc(100vh-64px)] items-center justify-center px-6 py-16">
    <div class="animate-fade-up w-full max-w-[420px]">

        {# Icône #}
        <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl border border-[#ff3b30]/20 bg-[#ff3b30]/[0.08]">
            <i class="fa-solid fa-key text-2xl text-[#ff3b30]"></i>
        </div>

        <h1 class="font-heading text-2xl font-extrabold tracking-[-0.03em] text-white md:text-3xl">
            Mot de passe oublié ?
        </h1>
        <p class="mt-3 mb-8 text-[0.88rem] leading-relaxed text-white/40">
            Entrez votre adresse e-mail et nous vous enverrons un lien pour réinitialiser votre mot de passe.
        </p>

        {# Erreurs flash #}
        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="mb-5 flex items-start gap-3 rounded-xl border border-[#ff4444]/20 bg-[#ff4444]/[0.07] px-4 py-3 text-[0.82rem] text-[#ff6b6b]">
                <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0"></i>
                {{ flash_error }}
            </div>
        {% endfor %}

        {# Formulaire #}
        <div class="rounded-2xl border border-white/[0.07] bg-[#111118] p-7">
            {{ form_start(requestForm) }}

                <div class="mb-5 flex flex-col gap-1.5">
                    {{ form_label(requestForm.email, 'Adresse e-mail', {
                        'label_attr': {'class': 'text-[0.72rem] font-semibold uppercase tracking-[0.06em] text-white/50'}
                    }) }}
                    {{ form_widget(requestForm.email, {
                        'attr': {
                            'class': 'w-full rounded-xl border border-white/[0.08] bg-white/[0.035] px-4 py-3 text-[0.875rem] text-[#f0f0f5] outline-none transition-all placeholder:text-white/20 focus:border-[#ff3b30]/50 focus:bg-white/[0.055] focus:ring-2 focus:ring-[#ff3b30]/[0.07]',
                            'placeholder': 'jean@exemple.com'
                        }
                    }) }}
                    <div class="text-[0.72rem] text-[#ff5555] [&_ul]:list-none [&_ul]:p-0">
                        {{ form_errors(requestForm.email) }}
                    </div>
                </div>

                <button type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#ff3b30] to-[#ff6b35] px-6 py-3.5 text-[0.9rem] font-semibold text-white shadow-lg shadow-[#ff3b30]/25 transition-all hover:-translate-y-px hover:shadow-xl hover:shadow-[#ff3b30]/35 active:translate-y-0">
                    <i class="fa-solid fa-paper-plane text-[0.85rem]"></i>
                    Envoyer le lien de réinitialisation
                </button>

            {{ form_end(requestForm) }}
        </div>

        <p class="mt-6 text-center text-[0.8rem] text-white/30">
            <a href="{{ path('app_login') }}" class="inline-flex items-center gap-1.5 font-medium text-white/50 transition-colors hover:text-white">
                <i class="fa-solid fa-arrow-left text-[0.72rem]"></i>
                Retour à la connexion
            </a>
        </p>

    </div>
</div>
{% endblock %}
