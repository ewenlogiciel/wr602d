{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — PDFactory{% endblock %}

{% block body %}
<div class="flex min-h-[calc(100vh-64px)] items-center justify-center px-6 py-16">
    <div class="animate-fade-up w-full max-w-[420px]">

        {# Icône #}
        <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl border border-[#34c759]/20 bg-[#34c759]/[0.07]">
            <i class="fa-solid fa-lock-open text-2xl text-[#34c759]"></i>
        </div>

        <h1 class="font-heading text-2xl font-extrabold tracking-[-0.03em] text-white md:text-3xl">
            Nouveau mot de passe
        </h1>
        <p class="mt-3 mb-8 text-[0.88rem] leading-relaxed text-white/40">
            Choisissez un nouveau mot de passe sécurisé pour votre compte.
        </p>

        {# Formulaire #}
        <div class="rounded-2xl border border-white/[0.07] bg-[#111118] p-7">
            {{ form_start(resetForm) }}

                {# ── Nouveau mot de passe ── #}
                <div class="mb-4 flex flex-col gap-1.5">
                    {{ form_label(resetForm.plainPassword.first, 'Nouveau mot de passe', {
                        'label_attr': {'class': 'text-[0.72rem] font-semibold uppercase tracking-[0.06em] text-white/50'}
                    }) }}
                    <div class="relative">
                        {{ form_widget(resetForm.plainPassword.first, {
                            'attr': {
                                'class': 'w-full rounded-xl border border-white/[0.08] bg-white/[0.035] px-4 py-3 pr-11 text-[0.875rem] text-[#f0f0f5] outline-none transition-all placeholder:text-white/20 focus:border-[#34c759]/50 focus:bg-white/[0.055] focus:ring-2 focus:ring-[#34c759]/[0.07]',
                                'placeholder': '6 caractères minimum'
                            }
                        }) }}
                        <button type="button"
                                onclick="togglePassword(this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-white/30 transition-colors hover:text-white/70"
                                tabindex="-1"
                                aria-label="Afficher/masquer le mot de passe">
                            <i class="fa-solid fa-eye text-[0.9rem]"></i>
                        </button>
                    </div>
                    <div class="text-[0.72rem] text-[#ff5555] [&_ul]:list-none [&_ul]:p-0">
                        {{ form_errors(resetForm.plainPassword.first) }}
                    </div>
                </div>

                {# ── Indicateur de force ── #}
                <div class="mb-4 flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.06em] text-white/30">Force du mot de passe</p>
                        <p class="text-[0.68rem] font-medium text-white/30" id="strength-label"></p>
                    </div>
                    <div class="flex gap-1.5">
                        <div class="h-1 flex-1 rounded-full bg-white/[0.08]" id="strength-1"></div>
                        <div class="h-1 flex-1 rounded-full bg-white/[0.08]" id="strength-2"></div>
                        <div class="h-1 flex-1 rounded-full bg-white/[0.08]" id="strength-3"></div>
                        <div class="h-1 flex-1 rounded-full bg-white/[0.08]" id="strength-4"></div>
                    </div>
                </div>

                {# ── Confirmer le mot de passe ── #}
                <div class="mb-6 flex flex-col gap-1.5">
                    {{ form_label(resetForm.plainPassword.second, 'Confirmer le mot de passe', {
                        'label_attr': {'class': 'text-[0.72rem] font-semibold uppercase tracking-[0.06em] text-white/50'}
                    }) }}
                    <div class="relative">
                        {{ form_widget(resetForm.plainPassword.second, {
                            'attr': {
                                'class': 'w-full rounded-xl border border-white/[0.08] bg-white/[0.035] px-4 py-3 pr-11 text-[0.875rem] text-[#f0f0f5] outline-none transition-all placeholder:text-white/20 focus:border-[#34c759]/50 focus:bg-white/[0.055] focus:ring-2 focus:ring-[#34c759]/[0.07]',
                                'placeholder': 'Répétez votre mot de passe'
                            }
                        }) }}
                        <button type="button"
                                onclick="togglePassword(this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-white/30 transition-colors hover:text-white/70"
                                tabindex="-1"
                                aria-label="Afficher/masquer le mot de passe">
                            <i class="fa-solid fa-eye text-[0.9rem]"></i>
                        </button>
                    </div>
                    <div class="text-[0.72rem] text-[#ff5555] [&_ul]:list-none [&_ul]:p-0">
                        {{ form_errors(resetForm.plainPassword.second) }}
                        {{ form_errors(resetForm.plainPassword) }}
                    </div>
                </div>

                <button type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#34c759] to-[#28a745] px-6 py-3.5 text-[0.9rem] font-semibold text-white shadow-lg shadow-[#34c759]/20 transition-all hover:-translate-y-px hover:shadow-xl hover:shadow-[#34c759]/30 active:translate-y-0">
                    <i class="fa-solid fa-check text-[0.85rem]"></i>
                    Réinitialiser le mot de passe
                </button>

            {{ form_end(resetForm) }}
        </div>

    </div>
</div>

<script>
    function togglePassword(btn) {
        const input = btn.previousElementSibling;
        const icon  = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    const input  = document.querySelector('input[type="password"]');
    const bars   = [1, 2, 3, 4].map(i => document.getElementById('strength-' + i));
    const label  = document.getElementById('strength-label');
    const colors = ['#ff3b30', '#ff6b35', '#ffb340', '#34c759'];
    const labels = ['Trop faible', 'Faible', 'Moyen', 'Fort', 'Très fort'];
    const labelColors = ['#ff3b30', '#ff6b35', '#ffb340', '#34c759', '#34c759'];

    // Même algorithme que Symfony PasswordStrengthValidator (entropie en bits)
    function estimateStrength(v) {
        if (!v) return -1;
        let pool = 0;
        if (/[a-z]/.test(v)) pool += 26;
        if (/[A-Z]/.test(v)) pool += 26;
        if (/[0-9]/.test(v)) pool += 10;
        if (/[^a-zA-Z0-9]/.test(v)) pool += 32;
        if (pool === 0) return 0;
        const entropy = v.length * Math.log2(pool);
        if (entropy >= 120) return 4;
        if (entropy >= 100) return 3;
        if (entropy >= 80)  return 2;
        if (entropy >= 60)  return 1;
        return 0;
    }

    if (input) {
        input.addEventListener('input', () => {
            const score = estimateStrength(input.value);

            bars.forEach((bar, i) => {
                bar.style.background = i < score ? colors[score - 1] : 'rgba(255,255,255,0.08)';
                bar.style.transition = 'background 0.3s';
            });

            if (score < 0 || input.value === '') {
                label.textContent = '';
            } else {
                label.textContent  = labels[score];
                label.style.color  = labelColors[score];
            }
        });
    }
</script>
{% endblock %}
