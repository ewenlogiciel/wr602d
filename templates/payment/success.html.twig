{% extends 'base.html.twig' %}

{% block title %}Paiement réussi — PDFactory{% endblock %}

{% block body %}
<div class="relative min-h-screen overflow-hidden flex items-center justify-center">

    {# Background effects #}
    <div class="pointer-events-none absolute inset-0">
        <div class="absolute top-[-20%] left-[10%] h-[600px] w-[600px] rounded-full bg-[#34c759]/[0.05] blur-[120px] animate-float"></div>
        <div class="absolute bottom-[-10%] right-[5%] h-[500px] w-[500px] rounded-full bg-[#34c759]/[0.04] blur-[100px] animate-float delay-300"></div>
    </div>

    {# Noise overlay #}
    <div class="pointer-events-none absolute inset-0 opacity-[0.03]"
         style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;">
    </div>

    <div class="relative z-10 mx-auto max-w-lg px-8 py-24 text-center">

        {# Icône succès #}
        <div class="mx-auto mb-8 flex h-24 w-24 items-center justify-center rounded-full border border-[#34c759]/20 bg-[#34c759]/[0.08] animate-fade-up">
            <svg class="h-12 w-12 text-[#34c759]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>

        <h1 class="font-heading text-4xl font-800 tracking-tight text-white animate-fade-up delay-100">
            Paiement confirmé !
        </h1>

        <p class="mt-4 text-lg leading-relaxed text-muted animate-fade-up delay-200">
            Merci pour votre abonnement. Votre plan est en cours d'activation — cela ne prend que quelques instants.
        </p>

        <div class="mt-4 rounded-xl border border-[#34c759]/15 bg-[#34c759]/[0.05] px-6 py-4 text-sm text-muted animate-fade-up delay-300">
            <p>Votre accès sera mis à jour automatiquement. Si ce n'est pas le cas dans les prochaines minutes, reconnectez-vous.</p>
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 animate-fade-up delay-400 sm:flex-row sm:justify-center">
            <a href="{{ path('app_tools') }}"
               class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#34c759] to-[#30d158] px-8 py-3.5 text-sm font-600 text-white shadow-xl shadow-[#34c759]/20 transition-all hover:shadow-2xl hover:shadow-[#34c759]/30 hover:scale-[1.02]">
                Accéder à mes outils
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </a>
            <a href="{{ path('app_home') }}"
               class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-8 py-3.5 text-sm font-600 text-white transition-all hover:border-border-hover hover:bg-[#22222e]">
                Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}
